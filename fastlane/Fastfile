# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

require "shellwords"

# ---------------------------------------------------------------------------
# Projekt-Einstellungen
#
# Alles, was beim Kopieren in ein anderes Projekt angepasst werden muss,
# steht hier. Bundle-ID und Team-IDs kommen aus dem Appfile, damit sie nicht
# an zwei Stellen gepflegt werden müssen.
# ---------------------------------------------------------------------------

# Wurzel des Repos. Das Fastfile liegt in <root>/fastlane, deshalb eine
# Ebene höher. Absolut, weil fastlane seine `sh`-Aufrufe im fastlane-Ordner
# ausführt - relative Pfade würden je nach Aufrufort woanders landen.
PROJECT_ROOT = File.expand_path("..", __dir__)

APP_IDENTIFIER = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
TEAM_ID        = CredentialsManager::AppfileConfig.try_fetch_value(:team_id)

SCHEME       = "Runner"
XCODEPROJ    = File.join(PROJECT_ROOT, "ios/Runner.xcodeproj")
WORKSPACE    = File.join(PROJECT_ROOT, "ios/Runner.xcworkspace")
PUBSPEC      = File.join(PROJECT_ROOT, "pubspec.yaml")

# So benennt match die Profile: "match <Typ> <Bundle-ID>".
PROFILE_NAME    = "match AppStore #{APP_IDENTIFIER}"
CODE_SIGN_IDENTITY = "Apple Distribution"

# ---------------------------------------------------------------------------
# Hilfsfunktionen
# ---------------------------------------------------------------------------

# Die Version steht bei Flutter in pubspec.yaml ("1.1.0+4"), nicht im
# Xcode-Projekt: das Runner-Target hat gar keine MARKETING_VERSION, und
# CFBundleShortVersionString ist auf $(FLUTTER_BUILD_NAME) gesetzt.
# get_version_number(xcodeproj:) würde hier also ins Leere greifen.
def flutter_app_version
  version = File.read(PUBSPEC)[/^version:\s*([^\s+]+)/, 1]
  UI.user_error!("Keine version: in #{PUBSPEC} gefunden!") if version.nil?
  version.strip
end

# Schreibt Version und Build-Nummer nach ios/Flutter/Generated.xcconfig und
# erzeugt die Plugin-Pakete neu. Muss vor build_app laufen: die Info.plist
# zieht CFBundleVersion aus $(FLUTTER_BUILD_NUMBER), increment_build_number
# im Xcode-Projekt hätte auf das gebaute Produkt keinerlei Wirkung.
def flutter_configure(version, build_number)
  sh("cd #{PROJECT_ROOT.shellescape} && flutter build ios --release --config-only " \
     "--build-name=#{version.shellescape} --build-number=#{build_number.to_s.shellescape}")
end

default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight (internal testers)"
  lane :beta_internal do
    # Check environment variables
    UI.user_error!("APP_STORE_CONNECT_KEY_ID is not set!") if ENV["APP_STORE_CONNECT_KEY_ID"].nil? || ENV["APP_STORE_CONNECT_KEY_ID"].empty?
    UI.user_error!("APP_STORE_CONNECT_ISSUER_ID is not set!") if ENV["APP_STORE_CONNECT_ISSUER_ID"].nil? || ENV["APP_STORE_CONNECT_ISSUER_ID"].empty?
    UI.user_error!("APP_STORE_CONNECT_KEY_CONTENT is not set!") if ENV["APP_STORE_CONNECT_KEY_CONTENT"].nil? || ENV["APP_STORE_CONNECT_KEY_CONTENT"].empty?
    UI.user_error!("TESTFLIGHT_GROUPS is not set!") if ENV["TESTFLIGHT_GROUPS"].nil? || ENV["TESTFLIGHT_GROUPS"].empty?
    UI.message("All environment variables are set.")

    app_version = flutter_app_version

    # Setup CI environment (creates keychain, installs WWDR certs)
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # Install certificates and profiles from match
    match(
      type: "appstore",
      readonly: false,
      api_key: api_key
    )

    # Disable automatic signing for CI
    update_code_signing_settings(
      use_automatic_signing: false,
      path: XCODEPROJ,
      team_id: TEAM_ID,
      profile_name: PROFILE_NAME,
      code_sign_identity: CODE_SIGN_IDENTITY
    )

    # Get latest build number from TestFlight for this version
    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      platform: "ios",
      version: app_version,
      initial_build_number: 0
    )
    new_build_number = latest_build + 1
    UI.message("App version: #{app_version}, Latest TestFlight build: #{latest_build}, New build number: #{new_build_number}")
    flutter_configure(app_version, new_build_number)

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      export_method: "app-store",
      export_team_id: TEAM_ID,
      export_options: {
        signingStyle: "manual",
        testFlightInternalTestingOnly: true,
        provisioningProfiles: {
          APP_IDENTIFIER => PROFILE_NAME
        }
      }
    )
    # Upload and distribute to internal tester groups
    # Note: Internal groups must be set to "Manual" distribution in App Store Connect
    groups = ENV["TESTFLIGHT_GROUPS"].split(",").map(&:strip)
    UI.message("Distributing to groups: #{groups}")
    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      groups: groups,
      distribute_external: false
    )
  end

  desc "Push a new beta build to TestFlight (external testers)"
  lane :beta_external do
    # Check environment variables
    UI.user_error!("APP_STORE_CONNECT_KEY_ID is not set!") if ENV["APP_STORE_CONNECT_KEY_ID"].nil? || ENV["APP_STORE_CONNECT_KEY_ID"].empty?
    UI.user_error!("APP_STORE_CONNECT_ISSUER_ID is not set!") if ENV["APP_STORE_CONNECT_ISSUER_ID"].nil? || ENV["APP_STORE_CONNECT_ISSUER_ID"].empty?
    UI.user_error!("APP_STORE_CONNECT_KEY_CONTENT is not set!") if ENV["APP_STORE_CONNECT_KEY_CONTENT"].nil? || ENV["APP_STORE_CONNECT_KEY_CONTENT"].empty?
    UI.user_error!("TESTFLIGHT_GROUPS is not set!") if ENV["TESTFLIGHT_GROUPS"].nil? || ENV["TESTFLIGHT_GROUPS"].empty?
    UI.message("All environment variables are set.")

    app_version = flutter_app_version

    # Setup CI environment (creates keychain, installs WWDR certs)
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # Install certificates and profiles from match
    match(
      type: "appstore",
      readonly: false,
      api_key: api_key
    )

    # Disable automatic signing for CI
    update_code_signing_settings(
      use_automatic_signing: false,
      path: XCODEPROJ,
      team_id: TEAM_ID,
      profile_name: PROFILE_NAME,
      code_sign_identity: CODE_SIGN_IDENTITY
    )

    # Get latest build number from TestFlight for this version
    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      platform: "ios",
      version: app_version,
      initial_build_number: 0
    )
    new_build_number = latest_build + 1
    UI.message("App version: #{app_version}, Latest TestFlight build: #{latest_build}, New build number: #{new_build_number}")
    flutter_configure(app_version, new_build_number)

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      export_method: "app-store",
      export_team_id: TEAM_ID,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          APP_IDENTIFIER => PROFILE_NAME
        }
      }
    )
    # External testers require explicit group distribution + beta review
    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      distribute_external: true,
      groups: ENV["TESTFLIGHT_GROUPS"].split(",").map(&:strip),
      notify_external_testers: true,
      changelog: ENV["BETA_CHANGELOG"]
    )
  end

  desc "Push a new release build to App Store Connect"
  lane :release do
    app_version = flutter_app_version

    # Setup CI environment (creates keychain, installs WWDR certs)
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # Install certificates and profiles from match
    match(
      type: "appstore",
      readonly: false,
      api_key: api_key
    )

    # Disable automatic signing for CI
    update_code_signing_settings(
      use_automatic_signing: false,
      path: XCODEPROJ,
      team_id: TEAM_ID,
      profile_name: PROFILE_NAME,
      code_sign_identity: CODE_SIGN_IDENTITY
    )

    # Get latest build number from TestFlight for this version
    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      platform: "ios",
      version: app_version,
      initial_build_number: 0
    )
    new_build_number = latest_build + 1
    UI.message("App version: #{app_version}, Latest TestFlight build: #{latest_build}, New build number: #{new_build_number}")
    flutter_configure(app_version, new_build_number)

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      export_method: "app-store",
      export_team_id: TEAM_ID,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          APP_IDENTIFIER => PROFILE_NAME
        }
      }
    )
    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false
    )
  end
end
